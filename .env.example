# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: trace every run + log eval experiments in LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=fineprint

# Optional overrides (defaults shown)
# FINEPRINT_PLANNER_MODEL=claude-haiku-5-5
# FINEPRINT_JUDGE_MODEL=claude-sonnet-5-5
# FINEPRINT_EXECUTOR_MODEL=claude-haiku-5-5
# FINEPRINT_EMBEDDINGS=local      # local | hashing (hashing = offline lexical fallback, lower quality)
# FINEPRINT_TOP_K=2               # clauses retrieved per checklist category
# FINEPRINT_MAX_REPAIRS=2
